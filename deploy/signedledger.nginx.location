    # Add INSIDE the existing server block of /etc/nginx/sites-available/cipherboard, above "location / {"
    location /ledger/ {
        limit_req zone=cipherboard burst=20 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8788/;      # trailing slash strips /ledger/
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append
    }
